#. Plugin Name of the plugin
#: events-calendar-ical-feeds.php
msgid "iCalendar Feeds for The Events Calendar"
msgstr "iCalendar-flöden för The Events Calender"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: events-calendar-ical-feeds.php
msgid "https://bernskioldmedia.com"
msgstr "https://bernskioldmedia.se"

#. Description of the plugin
#: events-calendar-ical-feeds.php
msgid ""
"Extends The Events Calendar with iCal feeds that users can subscribe to in "
"their favorite calendar application."
msgstr ""
"Utökar evenemangskalendern med iCal-flöden som användarna kan prenumerera på"
" i sitt favoritkalenderprogram."

#. Author of the plugin
#: events-calendar-ical-feeds.php
msgid "Bernskiold Media"
msgstr "Bernskiold Media"

