{
  "name": "bernskioldmedia/events-calendar-ical-feeds",
  "description": "Extends The Events Calendar with iCal feeds that users can subscribe to in their favorite calendar application.",
  "type": "wordpress-plugin",
  "homepage": "https://github.com/bernskioldmedia/events-calendar-ical-feeds",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "Bernskiold Media",
      "email": "info@bernskioldmedia.com"
    }
  ],
  "support": {
    "source": "https://github.com/bernskioldmedia/events-calendar-ical-feeds",
    "issues": "https://github.com/bernskioldmedia/events-calendar-ical-feeds/issues"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.2",
    "composer/installers": "^2.3",
    "spatie/icalendar-generator": "^3.3",
    "yahnis-elsts/plugin-update-checker": "^6.0"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^9.6",
    "wp-coding-standards/wpcs": "^3.4",
    "yoast/phpunit-polyfills": "^2.0 || ^3.0 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "BernskioldMedia\\WP\\EventsCalendarIcalFeeds\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "BernskioldMedia\\WP\\EventsCalendarIcalFeeds\\Tests\\": "tests/php/"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint-fix": "phpcbf",
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  }
}
