##
# Exclude from release archives.
#
# Here we add resources that are not needed in the download
# for production use. The release ZIP is built with `git archive`,
# so this list decides what goes into it.
##
.editorconfig           export-ignore
.gitattributes          export-ignore
.gitignore              export-ignore
.nvmrc                  export-ignore
.github                 export-ignore
.git                    export-ignore
.gitkeep                export-ignore
webpack.config.js       export-ignore
package.json            export-ignore
package-lock.json       export-ignore
CHANGELOG.md            export-ignore
README.md               export-ignore
/assets                 export-ignore
/tests                  export-ignore
/bin                    export-ignore
phpcs.xml.dist          export-ignore
phpunit.xml.dist        export-ignore
.wp-env.json            export-ignore
vitest.config.mjs       export-ignore

##
# Don't try and diff these...
##
composer.lock -diff
package-lock.json -diff
dist/*.js -diff
dist/*.css -diff
dist/*.asset.php -diff

##
# Handle line endings.
# See https://help.github.com/articles/dealing-with-line-endings/
##
* text eol=lf
*.php text
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.mo binary
