{
  "name": "events-calendar-ical-feeds",
  "version": "1.3.0",
  "description": "Extends The Events Calendar with iCal feeds that users can subscribe to in their favorite calendar application.",
  "private": true,
  "scripts": {
    "setup": "npm install && composer install && npm run build",
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "dev": "npm run start",
    "lint:js": "wp-scripts lint-js ./assets/scripts ./tests/unit",
    "lint:css": "wp-scripts lint-style \"assets/styles/**/*.css\"",
    "format": "wp-scripts format ./assets ./tests/unit",
    "test": "npm run test:unit",
    "test:unit": "wp-scripts test-unit-js",
    "test:unit:watch": "wp-scripts test-unit-js --watch",
    "test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/events-calendar-ical-feeds composer test",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "i18n": "npm run i18n:pot",
    "i18n:pot": "wp i18n make-pot . ./languages/events-calendar-ical-feeds.pot --exclude=\"node_modules,vendor,dist,tests\"",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "packages-update": "wp-scripts packages-update"
  },
  "engines": {
    "node": ">=22.22.2",
    "npm": ">=10"
  },
  "author": {
    "name": "Bernskiold Media",
    "email": "info@bernskioldmedia.com",
    "url": "https://bernskioldmedia.com",
    "role": "developer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernskiold/events-calendar-ical-feeds.git"
  },
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/bernskiold/events-calendar-ical-feeds/issues"
  },
  "homepage": "https://github.com/bernskiold/events-calendar-ical-feeds#readme",
  "devDependencies": {
    "@wordpress/env": "^10.39.0",
    "@wordpress/scripts": "^37.1.0",
    "jsdom": "^26.1.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
